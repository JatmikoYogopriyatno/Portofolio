<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikon adaptif. Android memotong lapisan depan dengan bentuk yang berbeda beda
  menurut peluncur yang dipakai: lingkaran, kotak membulat, atau kotak penuh.
  Monogramnya sengaja ditaruh di sepertiga tengah supaya tidak ada bentuk
  potongan yang memakan hurufnya.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/biru_tinta" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
